<div class="tab biography" data-group="primary" data-tab="description">
	<div class="flex-col pp-gap-md">

		{{! Question Card 1 }}
		<div class="pink-card flex-col curtains">
			<h3 class="pp-font-display">Minhas maldições, ferimentos e trauma...</h3>

			{{editor
				enriched.fairygodmother
				target="system.fairyGodmother"
				engine="prosemirror"
				button=true
				editable=editable
			}}

		</div>

		{{! Question Card 2 }}
		<div class="pink-card flex-col curtains">
			<h3 class="pp-font-display">Minha Fada Madrinha é...</h3>

			{{editor
				enriched.curses
				target="system.cursesWounds"
				engine="prosemirror"
				button=true
				editable=editable
			}}

		</div>

		{{! Question Card 3 }}
		<div class="pink-card flex-col curtains">
			<h3 class="pp-font-display">À primeira vista, as pessoas notam meu/minha...</h3>

			{{editor
				enriched.que1
				target="system.personalityQuestion1"
				engine="prosemirror"
				button=true
				editable=editable
			}}

		</div>

		{{! Question Card 4 }}
		<div class="pink-card flex-col curtains">
			<h3 class="pp-font-display">Quem me conhece bem acha que eu sou...</h3>

			{{editor
				enriched.que2
				target="system.personalityQuestion2"
				engine="prosemirror"
				button=true
				editable=editable
			}}

		</div>

		{{! Question Card 5 }}
		<div class="pink-card flex-col curtains">
			<h3 class="pp-font-display">Secretamente, no fundo, eu sou...</h3>

			{{editor
				enriched.que3
				target="system.personalityQuestion3"
				engine="prosemirror"
				button=true
				editable=editable
			}}

		</div>

		{{! Question Card 6 }}
		<div class="pink-card flex-col curtains">
			<h3 class="pp-font-display">O que realmente me motiva é...</h3>

			{{editor
				enriched.que4
				target="system.personalityQuestion4"
				engine="prosemirror"
				button=true
				editable=editable
			}}

		</div>

	</div>
</div>